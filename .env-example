# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (pick one architecture; see docs/03_architecture.md §3) ---
# Currently implemented: "anthropic" (services/agents/llm_providers.py::AnthropicCompleteFn).
# If LLM_PROVIDER/LLM_API_KEY are unset or unrecognized, the system falls back to a
# safe no-network stub (wiring.py::build_llm_client_from_env) - never an unauthorized call.
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=claude-haiku-4-5

# --- MCP server auth tokens (HW-F17: token-based auth + revoke) ---
MCP_COP_AUTH_TOKEN=replace-with-a-random-secret
MCP_THIEF_AUTH_TOKEN=replace-with-a-random-secret

# --- MCP server URLs (HW-F18: exactly 2 URLs per group) ---
MCP_COP_URL=http://127.0.0.1:8801
MCP_THIEF_URL=http://127.0.0.1:8802

# --- Gmail API / OAuth (HW-F21: automated report email, OAuth not password) ---
GMAIL_OAUTH_CLIENT_SECRET_PATH=replace-with-path-to-client-secret.json
GMAIL_OAUTH_TOKEN_PATH=replace-with-path-to-token.json
REPORT_RECIPIENT_EMAIL=rmisegal+uoh26b@gmail.com
